# ──────────────────────────────────────────────────────────────────────────────
# Google RISC Security Event Receiver – Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (for local development) or set these variables
# in your hosting platform (Vercel, Cloud Run, etc.) before deploying.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED ─────────────────────────────────────────────────────────────────────

# The publicly reachable URL of your RISC receiver endpoint.
# This MUST exactly match the URL you register with Google's RISC API.
# Typically: https://<your-domain>/security-event-receiver
RECEIVER_URL=https://your-app.vercel.app/security-event-receiver

# Google service account key (from Google Cloud Console → IAM → Service Accounts
# → your service account → Keys → Add Key → JSON).
# Paste the entire JSON content here as a single line, or Base64-encode the JSON
# and paste the Base64 string.
# The service account must have the roles described in README.md.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"risc-admin@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# OPTIONAL ─────────────────────────────────────────────────────────────────────

# Base URL of the application (without trailing slash).
# Used to derive RECEIVER_URL if RECEIVER_URL is not explicitly set.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Comma-separated allow-list of OAuth client IDs whose events this receiver
# should accept.  Full IDs including ".apps.googleusercontent.com".
# If omitted, events from all client IDs registered to your project are accepted.
# Example (multiple clients):
# ALLOWED_CLIENT_IDS=123456-abc.apps.googleusercontent.com,123456-def.apps.googleusercontent.com
ALLOWED_CLIENT_IDS=
